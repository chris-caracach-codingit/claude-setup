{
  "model": "claude-opus-5[1m]",
  "effortLevel": "high",
  "theme": "dark-daltonized",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$HOME/.claude/hooks/format-bash-command.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.session_id' | { read -r s; d=\"${XDG_RUNTIME_DIR:-/tmp}/claude-attention\"; mkdir -p \"$d\"; touch \"$d/${s:-default}\"; } 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.session_id' | { read -r s; rm -f \"${XDG_RUNTIME_DIR:-/tmp}/claude-attention/${s:-default}\"; } 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.session_id' | { read -r s; rm -f \"${XDG_RUNTIME_DIR:-/tmp}/claude-attention/${s:-default}\"; } 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "jq -r '.session_id' | { read -r s; rm -f \"${XDG_RUNTIME_DIR:-/tmp}/claude-attention/${s:-default}\"; } 2>/dev/null || true",
            "async": true
          }
        ]
      }
    ]
  },
  "enabledPlugins": {
    "slack@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-obsidian-marketplace": {
      "source": {
        "source": "github",
        "repo": "AgriciDaniel/claude-obsidian"
      }
    }
  }
}
