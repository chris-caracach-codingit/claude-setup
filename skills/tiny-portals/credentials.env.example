# Tiny Health portal credentials — SANDBOX/TEST accounts only.
# Copy to ~/prog/tiny-portals/credentials.env and fill in. Never commit real values.
# The tiny-portals skill reads this file; it never prints secret values into chat.

# Results Portal (supports multiple accounts)
RESULTS_ACCOUNTS=
RESULTS_DEFAULT=
RESULTS_EMAIL_NEWBORN=
RESULTS_PASS_NEWBORN=
RESULTS_EMAIL_BIO=
RESULTS_PASS_BIO=

# Practitioner / Partner / Ops portals
PRACTITIONER_EMAIL=
PRACTITIONER_PASSWORD=
PARTNER_EMAIL=
PARTNER_PASSWORD=
OPS_EMAIL=
OPS_PASSWORD=

# PDF report (JWT harvested from a Results session)
PDF_DEFAULT=
PDF_ADMIN_JWT=
PDF_SAMPLE_KIT_ID=
